# Rotifer public P2P node (T-231 B2 design §5.3). Installed by install.sh,
# upgrade.sh and rollback.sh from the deploy/ copy inside the release it
# runs, so the unit always matches the code.
[Unit]
Description=Rotifer public P2P node (bootstrap and relay)
Documentation=file:///opt/rotifer/current/deploy/RUNBOOK.md
Wants=network-online.target
After=network-online.target rotifer-firewall.service
Requires=rotifer-firewall.service
# Never give up restarting (design §5.3, R6/X10).
StartLimitIntervalSec=0

[Service]
Type=simple
User=rotifer
Group=rotifer
# /var/lib/rotifer, 0700, owned by rotifer: the node key, peers.json and
# daemon.json live in /var/lib/rotifer/.rotifer (HOME comes from the
# rotifer account, whose home is /var/lib/rotifer).
StateDirectory=rotifer
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rotifer
EnvironmentFile=/etc/rotifer/p2p.env
# A server answers no prompts and checks for no updates.
Environment=ROTIFER_NO_UPDATE_CHECK=1
Environment=DO_NOT_TRACK=1
# While the month's outbound quota is used up the node stays down, through
# reboots too ("+": runs as root, which can read /var/lib/rotifer-quota).
ExecCondition=+/opt/rotifer/current/deploy/rotifer-quota not-capped
ExecStart=/opt/rotifer/current/deploy/start.sh

# --foreground exits non-zero when the native event loop ends; restart
# after 5 s, stretching to 10 min while it keeps failing.
Restart=on-failure
RestartSec=5
RestartSteps=10
RestartMaxDelaySec=10min

StandardOutput=journal
StandardError=journal

# Sockets: 500 inbound + 128 pending + 50 outbound + relay reservations,
# with headroom.
LimitNOFILE=8192
# No MemoryMax: libp2p's memory limit compares the process with the whole
# machine's memory, not the cgroup's (design §5.3).

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rotifer
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# No ProcSubset=pid: libp2p's memory limit reads /proc/meminfo, and without it
# takes the machine's RAM as 0 and refuses every connection.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
