{
  "domain": "search",
  "description": "Search the web and return structured results with titles, URLs, and snippets. Supports configurable result count.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "description": "Search query string" },
      "maxResults": { "type": "integer", "default": 5, "minimum": 1, "maximum": 20 }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "url": { "type": "string" },
            "snippet": { "type": "string" }
          }
        }
      },
      "totalResults": { "type": "integer" },
      "searchTime": { "type": "number" }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-genesis",
  "fidelity": "Native",
  "transparency": "Open",
  "streamingCapability": null,
  "semanticRequirements": {
    "timeModel": "Async",
    "concurrencyModel": "Stateless",
    "failureSemantics": "Retry"
  },
  "tags": ["web-search", "results", "snippets", "async", "retrieval"]
}
