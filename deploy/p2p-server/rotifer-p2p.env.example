# /etc/rotifer/p2p.env — what the operator of a Rotifer public P2P node
# fills in (T-231 B2 design §5.2). install.sh copies this file there the
# first time and never overwrites it afterwards.
#
# No secret goes in this file, and none can: the node key is generated on
# the host at first start (/var/lib/rotifer/.rotifer/identity.pem) and the
# node holds no Cloud session.
#
# Keys are only ever added in later releases, each with a default, so an
# older release ignores keys it does not know.

# Public IPv4 address of this machine, as other nodes dial it. Required with
# ROTIFER_P2P_RELAY_SERVER=yes: a relay must announce where it is reached.
ROTIFER_P2P_PUBLIC_IP=

# TCP port for P2P (opened in the firewall; IPv4 only).
ROTIFER_P2P_PORT=9878

# yes: also serve as a Circuit Relay v2 relay (bootstrap and relay on one
# machine, CEO ruling C7). no: bootstrap only.
ROTIFER_P2P_RELAY_SERVER=yes

# Connection limits (design §2.1): inbound connections, and connections
# still in the handshake. Keep the per-IP firewall limit (20) well under the
# pending limit.
ROTIFER_P2P_MAX_INBOUND=500
ROTIFER_P2P_MAX_PENDING=128

# Other public bootstrap nodes, as full multiaddrs with /p2p/<PeerId>,
# separated by spaces. Empty: none.
ROTIFER_P2P_BOOTSTRAP=

# Outbound quota for each billing period, in bytes: 40% of the outbound
# traffic the plan includes (design §7.3). 1 TB included -> 400000000000.
ROTIFER_QUOTA_BYTES=400000000000

# Day of the month the provider's billing period starts (1-28): the quota
# goes back to zero on that day and a node stopped for the quota restarts.
ROTIFER_QUOTA_RESET_DAY=1
