{
  "domain": "prompt.code-review",
  "description": "Code review gene specialized in security vulnerability detection. Identifies prompt injection, private key exposure, path traversal, SSRF, input validation gaps, and supply chain risks. Part of the Code Review Assistant 3×2 arena competition.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "description": "Source code to review"
      },
      "language": {
        "type": "string",
        "description": "Programming language"
      },
      "context": {
        "type": "string",
        "description": "File path or component context"
      }
    },
    "required": [
      "code"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "warning",
                "info"
              ]
            },
            "category": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "fix": {
              "type": "string"
            }
          }
        }
      },
      "summary": {
        "type": "string"
      },
      "riskLevel": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "none"
        ]
      }
    }
  },
  "llmRequirements": {
    "templateFormat": "mustache",
    "templateVariables": [
      "code",
      "language",
      "context"
    ],
    "targetModels": [
      "claude-3",
      "gpt-4"
    ],
    "minContextWindow": 8192,
    "expectedOutputFormat": "json",
    "temperatureHint": 0.1,
    "maxOutputTokens": 4096,
    "systemPromptPath": "system-prompt.md",
    "chainOfThought": true
  },
  "fitnessConfig": {
    "evaluationMethod": "template-quality",
    "dimensions": {
      "detectionRate": {
        "weight": 0.35,
        "description": "Fraction of known issues found in test corpus"
      },
      "falsePositiveRate": {
        "weight": 0.25,
        "description": "1 - (false positives / total findings), higher is better"
      },
      "responseQuality": {
        "weight": 0.2,
        "description": "Actionability of fix suggestions"
      },
      "templateValidity": {
        "weight": 0.1,
        "description": "Template renders without error"
      },
      "resourceEfficiency": {
        "weight": 0.1,
        "description": "Token efficiency of rendered prompt"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "fidelity": "Wrapped",
  "transparency": "Open",
  "source": "development-genome",
  "tags": [
    "code-review",
    "security",
    "vulnerability",
    "arena"
  ]
}
