# Dependencies
node_modules/

# Build output
dist/
target/
*.node
index.d.ts
crates/rotifer-napi/index.js

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Runtime
.rotifer/
# Default `rotifer init` output when accidentally run from repo root.
my-rotifer-project/

# Lock files (Cargo.lock is committed for libraries)
# package-lock.json is committed

# Gene build artifacts (local by default; tracked benchmark samples stay grandfathered)
.gene-manifest.json
genes/**/.compile-result.json
genes/**/.arena-cache.json
genes/**/gene.wasm
genes/**/gene.ir.wasm

# Sandbox cache
*.tsbuildinfo

# Test artifacts
coverage/

# Local evaluation reports
arena-reports/

# Wrangler
.wrangler/

# Temp files
.temp/
supabase/.temp/
supabase/.branches/

# npm pack artifacts
package/
*.tgz

# Prevent cross-contamination from the workspace-level internal/ directory
internal/

# Report written by the scheduled nightly build-and-test run; regenerated each
# night, so it should never be committed.
NIGHTLY_REPORT.md

# Written by `clawhub package validate`, not by the sync pipeline.
plugins/rotifer/reports/

# Stryker mutation testing — the sandbox it builds per run, and the report it
# writes. The report is a CI artifact; the score that matters lives in
# docs/mutation-testing.md and in stryker.config.json's break threshold.
.stryker-tmp/
reports/mutation/
