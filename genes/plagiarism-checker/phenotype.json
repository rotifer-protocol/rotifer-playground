{
  "domain": "content.integrity",
  "description": "Check content for plagiarism and ensure originality. Identify potential copied content and guide proper attribution. Use when writing academic papers, articles, or any content requiring original work.",
  "inputSchema": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": {
        "type": "string",
        "description": "Text to check for plagiarism"
      },
      "referenceCorpus": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Reference texts to compare against"
      },
      "threshold": {
        "type": "number",
        "default": 0.8,
        "minimum": 0,
        "maximum": 1,
        "description": "Similarity threshold for flagging"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["originalityScore", "matches"],
    "properties": {
      "originalityScore": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Overall originality score (1 = fully original)"
      },
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "startIndex": {
              "type": "integer"
            },
            "endIndex": {
              "type": "integer"
            }
          }
        },
        "description": "Detected similar passages"
      },
      "verdict": {
        "type": "string",
        "enum": ["original", "minor-overlap", "significant-overlap", "plagiarized"],
        "description": "Overall assessment"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "createdAt": 1771939403269,
  "fidelity": "Wrapped",
  "transparency": "Open",
  "source": "skill",
  "tags": [
    "plagiarism",
    "originality",
    "academic",
    "integrity"
  ]
}
