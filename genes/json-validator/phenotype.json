{
  "domain": "data.validate",
  "description": "Validates JSON data against a JSON Schema definition, returning detailed validation errors with paths.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "description": "The JSON data to validate (any type)"
      },
      "schema": {
        "type": "object",
        "description": "JSON Schema to validate against"
      },
      "strict": {
        "type": "boolean",
        "description": "Disallow additional properties not in schema",
        "default": false
      }
    },
    "required": [
      "data",
      "schema"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "Whether the data passes validation"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "JSON path to the error (e.g. $.items[0].name)"
            },
            "message": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "keyword": {
              "type": "string",
              "description": "The schema keyword that failed (e.g. type, required)"
            }
          }
        },
        "description": "List of validation errors (empty if valid)"
      },
      "errorCount": {
        "type": "number",
        "description": "Total number of validation errors"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.1",
  "author": "rotifer-genesis",
  "fidelity": "Native",
  "transparency": "Open",
  "semanticRequirements": {
    "timeModel": "Sync",
    "concurrencyModel": "Stateless",
    "failureSemantics": "FAIL_FAST"
  },
  "tags": [
    "json-schema",
    "validation",
    "errors",
    "strict-mode",
    "data-quality"
  ],
  "irHash": "ba24ade5823b23ccd94110e7d95d64f6deafa0ea0bdf29e9d3a69b7ccd1aa555"
}
