{
  "domain": "product.review",
  "description": "Central project review hub coordinating all skills including product-manager. Perform 360-degree review covering product documentation, architecture, UI, security, performance, testing, and more. Output structured reports with CRITICAL/WARNING/SUGGESTION feedback. Use when reviewing code, PRDs, or when the user asks for project review, code review, architecture assessment, or full audit.",
  "inputSchema": {
    "type": "object",
    "required": [
      "target"
    ],
    "properties": {
      "target": {
        "type": "string",
        "description": "Code, PRD, or project artifact to review"
      },
      "reviewScope": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "architecture",
            "security",
            "performance",
            "testing",
            "documentation",
            "ui",
            "accessibility"
          ]
        },
        "default": [
          "architecture",
          "security",
          "testing"
        ],
        "description": "Review dimensions"
      },
      "severity": {
        "type": "string",
        "enum": [
          "all",
          "critical-only",
          "critical-and-warning"
        ],
        "default": "all",
        "description": "Minimum severity to report"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "findings",
      "summary"
    ],
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "warning",
                "suggestion",
                "info"
              ]
            },
            "category": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "fix": {
              "type": "string"
            }
          }
        },
        "description": "Review findings"
      },
      "summary": {
        "type": "object",
        "properties": {
          "totalIssues": {
            "type": "integer"
          },
          "criticalCount": {
            "type": "integer"
          },
          "warningCount": {
            "type": "integer"
          },
          "overallGrade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F"
            ]
          }
        },
        "description": "Review summary"
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Prioritized improvement recommendations"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "createdAt": 1771939417803,
  "fidelity": "Wrapped",
  "transparency": "Open",
  "source": "skill",
  "tags": [
    "review",
    "audit",
    "code-review",
    "quality"
  ]
}
