{
  "domain": "search",
  "description": "Agentic search over local files via Sirchmunk. Supports FAST (keyword cascade, ~2s), DEEP (Monte Carlo evidence sampling, ~10-30s), and FILENAME_ONLY modes. Requires a running Sirchmunk instance.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "description": "Natural language search query" },
      "paths": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Directories to search. Defaults to Sirchmunk configured paths."
      },
      "mode": {
        "type": "string",
        "enum": ["FAST", "DEEP", "FILENAME_ONLY"],
        "default": "FAST",
        "description": "FAST: greedy keyword cascade (~2 LLM calls). DEEP: Monte Carlo evidence sampling. FILENAME_ONLY: file discovery without content analysis."
      },
      "topKFiles": {
        "type": "integer",
        "default": 3,
        "minimum": 1,
        "maximum": 20,
        "description": "Maximum number of files to return evidence from"
      }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "answer": { "type": "string", "description": "Synthesized answer from evidence" },
      "evidences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "snippet": { "type": "string" },
            "summary": { "type": "string" }
          }
        }
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "mode": { "type": "string" },
      "searchTime": { "type": "number" }
    }
  },
  "dependencies": [],
  "version": "0.1.0",
  "author": "rotifer-protocol",
  "fidelity": "Wrapped",
  "sourceFramework": "sirchmunk",
  "transparency": "Open",
  "streaming_capability": null,
  "semantic_requirements": {
    "timeModel": "Async",
    "concurrencyModel": "Stateless",
    "failureSemantics": "Retry"
  },
  "network": {
    "allowedDomains": ["localhost", "127.0.0.1"],
    "timeoutMs": 60000,
    "maxResponseBytes": 5242880
  }
}
