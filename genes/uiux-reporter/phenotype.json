{
  "name": "uiux-reporter",
  "version": "0.2.0",
  "domain": "quality.uiux",
  "fidelity": "Hybrid",
  "description": "Transforms UI/UX analyzer violations into prioritized natural-language optimization report with effort estimates",
  "author": "Rotifer Protocol Contributors",
  "license": "Apache-2.0",
  "inputSchema": {
    "type": "object",
    "properties": {
      "score": { "type": "number", "description": "Overall quality score from uiux-analyzer" },
      "violations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rule": { "type": "string" },
            "severity": { "type": "string" },
            "message": { "type": "string" },
            "category": { "type": "string" }
          }
        }
      },
      "passed": { "type": "integer" },
      "total": { "type": "integer" },
      "categories": { "type": "object" }
    },
    "required": ["score", "violations"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "report": { "type": "string", "description": "Human-readable optimization report" },
      "prioritizedFixes": { "type": "array", "items": { "type": "string" } },
      "estimatedEffort": { "type": "string" }
    },
    "required": ["report", "prioritizedFixes", "estimatedEffort"]
  },
  "displayField": "report",
  "tags": ["uiux", "report", "accessibility", "optimization"],
  "dependencies": ["uiux-analyzer"],
  "transparency": "Open",
  "network": {
    "allowedDomains": [],
    "maxRequestsPerExecution": 0,
    "timeoutMs": 5000
  },
  "semanticRequirements": {
    "timeModel": "Sync",
    "concurrencyModel": "Stateless",
    "failureSemantics": "Retry"
  }
}
