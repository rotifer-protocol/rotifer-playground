{
  "domain": "sim.particle",
  "description": "N-body gravitational simulation using brute-force all-pairs direct summation. Computes exact O(n^2) pairwise interactions per step — maximum accuracy baseline. Supports preset configurations (solar system, binary star, galaxy cluster, collision).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "particles": {
        "type": "array",
        "description": "Initial particle states. Ignored if preset is provided.",
        "items": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "vx": {
              "type": "number"
            },
            "vy": {
              "type": "number"
            },
            "mass": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "vx",
            "vy",
            "mass"
          ]
        }
      },
      "preset": {
        "type": "string",
        "description": "Preset particle configuration",
        "enum": [
          "solar",
          "binary",
          "cluster",
          "collision"
        ]
      },
      "count": {
        "type": "number",
        "description": "Number of particles for preset generation",
        "default": 64,
        "minimum": 2,
        "maximum": 2048
      },
      "steps": {
        "type": "number",
        "description": "Number of simulation steps",
        "default": 100,
        "minimum": 1,
        "maximum": 10000
      },
      "dt": {
        "type": "number",
        "description": "Time step size",
        "default": 0.01
      },
      "G": {
        "type": "number",
        "description": "Gravitational constant",
        "default": 1
      },
      "softening": {
        "type": "number",
        "description": "Softening parameter to prevent singularity at close range",
        "default": 0.01
      },
      "seed": {
        "type": "number",
        "description": "Random seed for preset generation (deterministic output)"
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "particles": {
        "type": "array",
        "description": "Final particle states after simulation",
        "items": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "vx": {
              "type": "number"
            },
            "vy": {
              "type": "number"
            },
            "mass": {
              "type": "number"
            }
          }
        }
      },
      "steps_computed": {
        "type": "number",
        "description": "Actual number of simulation steps computed"
      },
      "total_energy": {
        "type": "number",
        "description": "Total system energy (kinetic + potential) at final state"
      },
      "interactions_computed": {
        "type": "number",
        "description": "Total pairwise force evaluations across all steps"
      }
    },
    "required": [
      "particles",
      "steps_computed",
      "total_energy",
      "interactions_computed"
    ]
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "fidelity": "Native",
  "transparency": "Open",
  "irHash": "bfea26086b4eb933a0e986a331e8c102971858de4d73b7b8e85788f40c6381aa",
  "tags": [
    "n-body",
    "gravity",
    "simulation",
    "brute-force",
    "benchmark"
  ]
}
