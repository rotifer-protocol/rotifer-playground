{
  "domain": "content.factcheck",
  "description": "Verify facts, claims, and sources in written content. Ensure accuracy and credibility of information. Use when writing news, reports, or any content where factual accuracy is critical.",
  "inputSchema": {
    "type": "object",
    "required": ["claims"],
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of claims to verify"
      },
      "context": {
        "type": "string",
        "description": "Context or source document containing the claims"
      },
      "strictness": {
        "type": "string",
        "enum": ["lenient", "standard", "strict"],
        "default": "standard",
        "description": "Verification strictness level"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["results", "overallScore"],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string"
            },
            "verdict": {
              "type": "string",
              "enum": ["verified", "partially-true", "unverified", "false", "needs-context"]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "description": "Verification results per claim"
      },
      "overallScore": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Overall factual accuracy score"
      },
      "corrections": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Suggested corrections for false claims"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "createdAt": 1771939404880,
  "fidelity": "Wrapped",
  "transparency": "Open",
  "source": "skill",
  "tags": [
    "fact-checking",
    "verification",
    "accuracy",
    "sources"
  ]
}
