{
  "domain": "prompt.rule-router",
  "description": "Rule routing strategy that prioritizes semantic relevance. Scores each rule by triggerWord overlap density with the user message, injecting the most contextually relevant rules first. Variant B of the Rule Router Gene competition.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "userMessage": {
        "type": "string",
        "description": "The user's current message/query"
      },
      "availableRules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "triggerWords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frequency": {
              "type": "integer",
              "description": "Historical trigger count"
            },
            "sizeTokens": {
              "type": "integer"
            }
          }
        },
        "description": "Available rules with metadata"
      },
      "contextBudget": {
        "type": "integer",
        "description": "Maximum tokens available for rule injection",
        "default": 4096
      }
    },
    "required": [
      "userMessage",
      "availableRules"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "selectedRules": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Ordered list of rule names to inject"
      },
      "totalTokens": {
        "type": "integer",
        "description": "Total token cost of selected rules"
      },
      "strategy": {
        "type": "string",
        "description": "Routing strategy explanation"
      }
    }
  },
  "llmRequirements": {
    "templateFormat": "mustache",
    "templateVariables": [
      "userMessage",
      "availableRules",
      "contextBudget"
    ],
    "targetModels": [
      "claude-3",
      "gpt-4"
    ],
    "minContextWindow": 4096,
    "expectedOutputFormat": "json",
    "temperatureHint": 0.1,
    "maxOutputTokens": 1024,
    "systemPromptPath": "system-prompt.md",
    "chainOfThought": true
  },
  "fitnessConfig": {
    "evaluationMethod": "template-quality",
    "dimensions": {
      "routeHitRate": {
        "weight": 0.4,
        "description": "Fraction of injected rules actually triggered by user message"
      },
      "contextSavings": {
        "weight": 0.3,
        "description": "1 - (usedTokens / contextBudget)"
      },
      "templateValidity": {
        "weight": 0.2,
        "description": "Template renders without error for all valid inputs"
      },
      "crossModelConsistency": {
        "weight": 0.1,
        "description": "Same input produces same rule selection across models"
      }
    }
  },
  "dependencies": [],
  "version": "0.2.0",
  "author": "rotifer-team",
  "fidelity": "Wrapped",
  "transparency": "Open",
  "source": "development-genome",
  "tags": [
    "rule-routing",
    "relevance",
    "context-management",
    "arena"
  ]
}
