{
  "testCases": [
    {
      "input": { "query": "WebAssembly component model", "maxResults": 3 },
      "expectedSchema": {
        "type": "object",
        "required": ["results", "totalResults"],
        "properties": {
          "totalResults": { "type": "integer", "minimum": 1, "maximum": 3 },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["title", "url", "snippet"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string", "pattern": "^https?://" },
                "snippet": { "type": "string" }
              }
            }
          }
        }
      },
      "timeout": 20000
    },
    {
      "input": { "query": "rotifer biology", "maxResults": 1 },
      "expectedSchema": {
        "type": "object",
        "required": ["results", "totalResults"],
        "properties": {
          "results": { "type": "array", "minItems": 1, "maxItems": 1 },
          "totalResults": { "const": 1 }
        }
      },
      "timeout": 20000
    }
  ]
}
