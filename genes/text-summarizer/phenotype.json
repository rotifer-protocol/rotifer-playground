{
  "author": "rotifer-genesis",
  "domain": "text.summarize",
  "version": "0.2.0",
  "fidelity": "Native",
  "description": "Extracts key sentences from text to produce a concise summary within a configurable word limit.",
  "inputSchema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "description": "The text content to summarize"
      },
      "format": {
        "enum": [
          "paragraph",
          "bullets"
        ],
        "type": "string",
        "default": "paragraph",
        "description": "Output format"
      },
      "maxWords": {
        "type": "number",
        "default": 100,
        "description": "Maximum words in the summary"
      }
    }
  },
  "dependencies": [],
  "outputSchema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "description": "The generated summary"
      },
      "wordCount": {
        "type": "number",
        "description": "Actual word count of the summary"
      },
      "keyPhrases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Extracted key phrases"
      },
      "compressionRatio": {
        "type": "number",
        "description": "Ratio of summary length to original length (0-1)"
      }
    }
  },
  "transparency": "Open",
  "semanticRequirements": {
    "timeModel": "Sync",
    "concurrencyModel": "Stateless",
    "failureSemantics": "FAIL_FAST"
  },
  "tags": ["summarization", "compression", "key-phrases", "nlp", "extractive"]
}
